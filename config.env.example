# byte-by-byte configuration
# Copy this to config.env and fill in your values:
#   cp config.env.example config.env
#
# PREREQUISITES (self-host / Option 4):
#   - OpenClaw installed and authenticated to an LLM provider (https://openclaw.ai)
#     with its Telegram channel connected — content generation and Telegram
#     delivery both run through it. Email (below) is the only OpenClaw-free path.
#   - A Gmail account with an App Password (for the email digest).

# Path to this repo (no trailing slash)
BBB_REPO_DIR="/path/to/byte-by-byte"

# OpenClaw binary path
OPENCLAW_BIN="/path/to/openclaw"

# Telegram delivery target — your numeric Telegram user ID. OpenClaw's Telegram
# channel/bot must be connected first, or messages to this ID won't arrive.
# (Get your ID from @userinfobot on Telegram.)
TELEGRAM_TARGET="YOUR_TELEGRAM_ID"

# Email for daily digest
EMAIL_TARGET="your@email.com"

# ── Fork/rebrand (Option 5): point links at YOUR site/repo, not the original.
SITE_BASE_URL="https://yourname.github.io/byte-by-byte"
GITHUB_REPO="yourname/byte-by-byte"

# Schedule (cron expressions, timezone)
CRON_SCHEDULE="0 8 * * *"
QA_SCHEDULE="15 8 * * *"
TIMEZONE="America/Los_Angeles"

# Gmail SMTP (App Password — NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_USER="your@gmail.com"
SMTP_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Subscriber sheet (optional — leave empty to send only to EMAIL_TARGET).
# Setup: make a Google Form with an email field → open its linked responses
# Sheet → File → Share → Publish to web → choose the sheet → CSV → copy that
# URL here. Repeat with a second form for unsubscribes. TLS is verified on
# fetch, so the CSV must be served over a valid HTTPS cert (Google's is fine).
SUBSCRIBERS_CSV_URL=""
UNSUBSCRIBE_CSV_URL=""
UNSUBSCRIBE_FORM_URL=""

# Model for content generation
MODEL="sonnet"
